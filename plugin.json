{
  "id": "milsymb",
  "name": "Military Symbols Library",
  "version": "0.2.0",
  "description": "APP-6D (MIL-STD-2525D) SIDC tagging and schematic affiliation styling for vector layers.",
  "author": "Michael Lanini",
  "homepage": "https://www.intelligeo.ch/",
  "license": "MIT",
  "entry": "plugin.wasm",
  "abi": 1,
  "minRustgisVersion": "0.3.0",
  "permissions": ["edit"],
  "commands": [
    {
      "id": "about",
      "label": "MilSymbols\nAbout",
      "help": "Show the plugin scope and the APP-6D tagging workflow.",
      "icon": "info",
      "params": "{}"
    },
    {
      "id": "style-app6",
      "label": "Style by\nAffiliation",
      "help": "Apply APP-6D affiliation colours (Unique Values) to the active or named layer. Tag it first.",
      "icon": "buffer",
      "params": "{\"input\"?: layer name (default: the active layer)}"
    }
  ],
  "tools": [
    {
      "id": "tag-layer",
      "name": "Tag Layer With APP-6D SIDC",
      "summary": "Copies a vector layer and enriches APP-6D (MIL-STD-2525D) SIDC semantics: version, context, affiliation, symbol set, status and amplifiers.",
      "toolbox": "MilGeo Tactical",
      "params": [
        { "name": "input", "label": "Input layer", "kind": "vectorLayer", "required": true },
        { "name": "sidc", "label": "Default SIDC (20 digits)", "kind": "text", "required": false, "default": "" },
        { "name": "sidcField", "label": "SIDC field name", "kind": "text", "required": false, "default": "sidc" },
        { "name": "label", "label": "Override label", "kind": "text", "required": false, "default": "" },
        { "name": "labelField", "label": "Label field name", "kind": "text", "required": false, "default": "symbol_label" },
        { "name": "overrideExisting", "label": "Override existing APP-6 fields", "kind": "bool", "required": false, "default": true }
      ]
    }
  ],
  "i18n": {
    "en_US": {
      "MilSymbols\nAbout": "MilSymbols\nAbout",
      "Style by\nAffiliation": "Style by\nAffiliation",
      "Tag Layer With APP-6D SIDC": "Tag Layer With APP-6D SIDC",
      "Input layer": "Input layer",
      "Default SIDC (20 digits)": "Default SIDC (20 digits)",
      "SIDC field name": "SIDC field name",
      "Override label": "Override label",
      "Label field name": "Label field name",
      "Override existing APP-6 fields": "Override existing APP-6 fields",
      "MilGeo Tactical": "MilGeo Tactical"
    },
    "fr_FR": {
      "MilSymbols\nAbout": "MilSymbols\nÀ propos",
      "Style by\nAffiliation": "Style par\nAffiliation",
      "Tag Layer With APP-6D SIDC": "Étiqueter la couche avec SIDC APP-6D",
      "Input layer": "Couche source",
      "Default SIDC (20 digits)": "SIDC par défaut (20 chiffres)",
      "SIDC field name": "Nom du champ SIDC",
      "Override label": "Remplacer le libellé",
      "Label field name": "Nom du champ de libellé",
      "Override existing APP-6 fields": "Remplacer les champs APP-6 existants",
      "MilGeo Tactical": "MilGeo Tactique"
    },
    "it_IT": {
      "MilSymbols\nAbout": "MilSymbols\nInfo",
      "Style by\nAffiliation": "Stile per\nAffiliazione",
      "Tag Layer With APP-6D SIDC": "Tagga layer con SIDC APP-6D",
      "Input layer": "Layer di input",
      "Default SIDC (20 digits)": "SIDC predefinita (20 cifre)",
