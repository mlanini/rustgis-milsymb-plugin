      "SIDC field name": "SIDC field name",
      "Override label": "Override label",
      "Label field name": "Label field name",
      "Override existing APP-6 fields": "Override existing APP-6 fields",
      "MilGeo Tactical": "MilGeo Tactical",
      "Symbol catalog": "Symbol catalog",
      "Symbol editor": "Symbol editor",
      "Modifier editor": "Modifier editor"
    },
