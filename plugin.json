{
  "id": "milsymb",
  "name": "Military Symbols Library",
  "version": "0.2.0",
  "description": "APP-6D (MIL-STD-2525D) SIDC tagging and schematic affiliation styling for vector layers.",
  "author": "Michael Lanini",
  "homepage": "https://www.intelligeo.ch/",
  "license": "MIT",
  "entry": "plugin.wasm",
  "abi": 1,
  "minRustgisVersion": "0.3.0",
  "permissions": ["edit"],
  "commands": [
    {
      "id": "about",
      "label": "MilSymbols\nAbout",
      "help": "Show the plugin scope and the APP-6D tagging workflow.",
      "icon": "info",
      "params": "{}"
    },
    {
      "id": "catalog",
      "label": "Symbol\nCatalog",
      "help": "Browse the APP-6D symbol catalog and inspect the available symbol families.",
      "icon": "bookmark",
      "params": "{}"
    },
    {
      "id": "symbol-editor",
      "label": "Symbol\nEditor",
      "help": "Open the APP-6D symbol editor for the selected military symbol.",
      "icon": "buffer",
      "params": "{}"
    },
    {
      "id": "modifier-editor",
      "label": "Modifier\nEditor",
      "help": "Adjust APP-6D modifier fields, qualifiers and tactical annotations.",
      "icon": "stats",
      "params": "{}"
    },
    {
      "id": "settings",
      "label": "Settings",
      "help": "Adjust APP-6D defaults, rendering and SIDC handling preferences.",
      "icon": "zoom_full",
      "params": "{}"
    },
    {
      "id": "symbol-editor-state",
      "label": "SIDC\nState",
      "help": "Read the live APP-6D panel state for the SIDC editor and catalog filters.",
      "icon": "stats",
      "params": "{}"
    },
    {
      "id": "style-app6",
      "label": "Style by\nAffiliation",
      "help": "Apply APP-6D affiliation colours (Unique Values) to the active or named layer. Tag it first.",
      "icon": "buffer",
      "params": "{\"input\"?: layer name (default: the active layer)}"
    }
  ],
  "tools": [
    {
      "id": "tag-layer",
      "name": "Tag Layer With APP-6D SIDC",
      "summary": "Copies a vector layer and enriches APP-6D (MIL-STD-2525D) SIDC semantics: version, context, affiliation, symbol set, status and amplifiers.",
      "toolbox": "MilGeo Tactical",
      "params": [
        { "name": "input", "label": "Input layer", "kind": "vectorLayer", "required": true },
        { "name": "sidc", "label": "Default SIDC (20 digits)", "kind": "text", "required": false, "default": "" },
        { "name": "sidcField", "label": "SIDC field name", "kind": "text", "required": false, "default": "sidc" },
        { "name": "label", "label": "Override label", "kind": "text", "required": false, "default": "" },
        { "name": "labelField", "label": "Label field name", "kind": "text", "required": false, "default": "symbol_label" },
        { "name": "overrideExisting", "label": "Override existing APP-6 fields", "kind": "bool", "required": false, "default": true }
      ]
    }
  ],
  "tab": {
    "label": "APP-6D",
    "groups": [
      {
        "label": "APP-6D",
        "items": [
          "catalog",
          "symbol-editor",
          "modifier-editor",
          "settings",
          "about",
          "style-app6",
          "tool:tag-layer"
        ]
      }
    ]
  },
  "panel": {
    "title": "APP-6D",
    "icon": "bookmark",
    "help": "APP-6D symbol catalog, symbol editing, modifier editing and settings.",
    "state": "symbol-editor-state",
    "items": [
      { "kind": "text", "id": "catalog-section", "label": "Symbol catalog", "text": "Scroll the APP-6D symbol families and choose the one to inspect." },
      { "kind": "slider", "id": "catalog-family", "label": "Family", "min": 0, "max": 7, "default": 0, "command": "catalog" },
      { "kind": "slider", "id": "context", "label": "Context", "min": 0, "max": 2, "default": 0, "command": "symbol-editor" },
      { "kind": "slider", "id": "affiliation", "label": "Affiliation", "min": 0, "max": 6, "default": 3, "command": "symbol-editor" },
      { "kind": "slider", "id": "status", "label": "Status", "min": 0, "max": 5, "default": 0, "command": "symbol-editor" },
      { "kind": "slider", "id": "modifier", "label": "Modifier", "min": 0, "max": 3, "default": 0, "command": "modifier-editor" },
      { "kind": "slider", "id": "amplifier", "label": "Amplifier", "min": 0, "max": 99, "default": 0, "command": "modifier-editor" },
      { "kind": "text", "id": "sidc-preview", "label": "Generated SIDC", "text": "10031000121103000000" },
      { "kind": "checkbox", "id": "strict-validation", "label": "Strict SIDC validation", "default": true, "command": "settings" },
      { "kind": "button", "command": "catalog", "label": "Open catalog" },
      { "kind": "button", "command": "symbol-editor", "label": "Apply symbol" },
      { "kind": "button", "command": "modifier-editor", "label": "Apply modifier" },
      { "kind": "button", "command": "settings", "label": "Apply settings" }
    ]
  },
